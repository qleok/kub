# Local diagnosis works without environment variables.
# The service reads the process environment. It does not load .env automatically.
# Set both values below to enable model prioritization in agent mode.
# KIC_LLM_BASE_URL=http://127.0.0.1:8080/v1
# KIC_LLM_MODEL=your-model
# Set an API key only if your compatible provider requires a bearer token.
# KIC_LLM_API_KEY=

# Set one namespace to enable live Pod diagnosis. Unset disables the endpoint.
# KIC_K8S_NAMESPACE=incident-demo
# Leave these unset to use mounted service account credentials inside Kubernetes.
# Set an explicit kubeconfig path with static credentials for local access.
# KIC_K8S_KUBECONFIG=/path/to/incident-reader.kubeconfig
# Optional context override for that kubeconfig. The default is its current context.
# KIC_K8S_CONTEXT=incident-reader
