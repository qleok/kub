# Local diagnosis works without environment variables.
# The service reads the process environment. It does not load .env automatically.
# Set both values below to enable model prioritization in agent mode.
# KIC_LLM_BASE_URL=http://127.0.0.1:8080/v1
# KIC_LLM_MODEL=your-model
# Set an API key only if your compatible provider requires a bearer token.
# KIC_LLM_API_KEY=
